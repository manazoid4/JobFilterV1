{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && next build",
  "regions": ["lhr1"],
  "functions": {
    "src/app/api/listings/ingest/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/listings/[id]/analyze/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/copilot/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/daily-pipeline/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-pipeline",
      "schedule": "0 6 * * *"
    }
  ]
}
