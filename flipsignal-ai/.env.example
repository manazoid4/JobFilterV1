# Database (Supabase / Neon Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/flipsignal?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/flipsignal?schema=public"

# Clerk (auth)
